# Tile cache. Reproducible from the network, and large: 18 MB for one route.
routes/*/data/cache/

# Derived rasters and textures. fetch_dem.py and fetch_sat.py rebuild these from
# the tile sources, and sat.jpg alone is 3.3 MB per route -- a repo that carries
# them gets heavy fast, and they are not what anyone reads.
routes/*/data/dem.npz
routes/*/data/sat.jpg
routes/*/site/sat.jpg

# Build output. `route-studio build` regenerates it from data/ + route.toml.
routes/*/site/scene.bin
routes/*/site/scene.json
routes/*/site/terrain.html
routes/*/site/roadbook.html

__pycache__/
*.pyc
